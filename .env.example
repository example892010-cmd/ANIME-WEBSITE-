# PocketBase service URL (use the server-side URL, not localhost, in production)
POCKETBASE_URL=http://127.0.0.1:8090
NEXT_PUBLIC_POCKETBASE_URL=http://127.0.0.1:8090

# PocketBase superuser credentials. Used only by the Next.js server for admin CRUD.
PB_SUPERUSER_EMAIL=admin@example.com
PB_SUPERUSER_PASSWORD=replace-with-your-pocketbase-superuser-password

# First-run website admin password. Choose a unique strong value yourself.
# It is hashed and saved in PocketBase at first admin setup. Remove this variable afterwards.
ADMIN_INITIAL_PASSWORD=

# Use a unique random value of 32+ characters. Keep this server-side only.
ADMIN_SESSION_SECRET=

# Private recovery code for the Admin Settings "Forgot password" flow.
ADMIN_RECOVERY_CODE=

# Shared secret used only by your private Telegram admin bot to request a session.
TELEGRAM_ADMIN_BOT_SECRET=

# Optional Redis cache. Omit to use the built-in in-memory cache.
REDIS_URL=

# Optional desktop companion URL.
NEXT_PUBLIC_LOCAL_PROXY_URL=http://127.0.0.1:43210
DOMAIN_URL=localhost:3000
NODE_ENV=development
